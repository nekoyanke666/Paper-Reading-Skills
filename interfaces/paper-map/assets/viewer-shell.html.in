<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Paper title</title><style>
:root{--bg:#f7f8f4;--ink:#233930;--muted:#77847b;--border:#dce4dc;--accent:#23765c;--soft:#edf5ed;--blue:#5c7d92}*{box-sizing:border-box}body{margin:0;color:var(--ink);background:var(--bg);font-family:Inter,"Segoe UI","Microsoft JhengHei",sans-serif}button,input,select,textarea{font:inherit;color:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #7bb497;outline-offset:3px}.app{height:100vh;display:grid;grid-template-columns:minmax(0,1fr) 0;transition:grid-template-columns .18s}.app.open{grid-template-columns:minmax(0,1fr) 350px}.main{min-width:0;padding:25px 25px 20px;display:flex;flex-direction:column;gap:19px}.topbar{display:flex;align-items:center;gap:13px;min-height:43px}.topbar h1{font-size:24px;font-weight:600;margin:0;line-height:1.5;flex:1;min-width:0;letter-spacing:.025em}.tree-select{max-width:230px;padding:10px 11px;border:1px solid var(--border);border-radius:6px;background:#fff;font-size:12px}.search-wrap{position:relative;width:210px}.search{width:100%;padding:10px 12px;border:1px solid var(--border);border-radius:6px;background:#fff;font-size:12px}.search-results{position:absolute;right:0;top:44px;width:350px;max-height:420px;overflow:auto;border:1px solid #cddcce;border-radius:7px;background:#fff;z-index:50;box-shadow:0 9px 30px #163d2217}.search-result{display:block;text-align:left;width:100%;padding:13px 15px;border:0;border-bottom:1px solid #eef2eb;background:#fff;font-size:13px}.search-result:hover{background:#f1f7ed}.search-result span{display:block;font-size:11px;line-height:1.8;color:#7d8c7d;margin-top:4px}.empty-result{font-size:12px;line-height:1.8;padding:15px;color:var(--muted)}.toggle{padding:10px 13px;white-space:nowrap;background:#fff;border:1px solid var(--border);border-radius:6px;font-size:12px}.toggle[aria-pressed=true]{background:var(--soft);border-color:#83af94;color:var(--accent)}.map{position:relative;flex:1;min-height:0;border:1px solid var(--border);border-radius:10px;overflow:auto;background:#fcfdfa;background-image:radial-gradient(#d2ddcf .75px,transparent .75px);background-size:20px 20px;scrollbar-width:thin;scrollbar-color:#bdcdbd transparent;overscroll-behavior:contain}.map.dragging{cursor:grabbing;user-select:none}.extent{position:relative;margin:auto;min-height:100%}.board{position:relative;transform-origin:0 0}.edges{position:absolute;inset:0;overflow:visible;pointer-events:none}.edge{fill:none;stroke:#aabeb0;stroke-width:1.7}.edge.support{stroke:var(--accent);stroke-width:2}.edge.causal{stroke:var(--blue);stroke-width:2}.edge.limitation{stroke:#a58c65}.edge.unconfirmed{stroke-dasharray:6 4}.edge-group.dim{opacity:.15}.edge-group.selected .edge{stroke-width:3}.edge-label{pointer-events:auto;cursor:pointer}.edge-label rect{fill:#fcfdfa;stroke:#d9e3d8;stroke-width:.9;rx:5}.edge-label text{fill:#5c7162;font:11px "Segoe UI","Microsoft JhengHei",sans-serif;text-anchor:middle;dominant-baseline:middle;pointer-events:none}.edge-label:hover rect,.edge-label:focus rect,.edge-group.selected rect{fill:#eaf4e9;stroke:#7d9f84}.node{position:absolute;width:170px;height:62px;border:1px solid #cbdacf;border-radius:8px;background:#fff;box-shadow:0 3px 12px #21433204;transition:opacity .16s,border-color .16s}.node.root{background:#edf6ed;border-color:#6eaa87}.node.selected{border-color:var(--accent);box-shadow:0 0 0 2px #23765c19;background:#f4faf2}.node.dim{opacity:.2}.node-main{width:100%;height:100%;border:0;border-radius:8px;background:transparent;padding:10px 15px;font-size:16px;font-weight:600;line-height:1.45;letter-spacing:.015em;text-align:center}.node-main:hover{background:#f2f8ef}.shared{position:absolute;top:-12px;right:-10px;min-width:30px;height:25px;background:#fff;border:1px solid #b4cfbb;border-radius:13px;color:#367f50;font-size:11px;padding:2px 6px;z-index:2}.shared:hover{background:#e5f3e7}.new-node{animation:newNode 1.8s ease-out}.revised{border-style:dashed}.details{min-width:0;overflow:auto;background:#fff;padding:0;visibility:hidden}.app.open .details{border-left:1px solid var(--border);padding:24px 21px;visibility:visible}.detail-top{display:flex;align-items:center;justify-content:space-between;gap:10px}.kind{font-size:11px;color:var(--accent);background:var(--soft);padding:5px 8px;border-radius:4px}.close{border:1px solid var(--border);border-radius:5px;background:#fff;padding:5px 9px;font-size:13px}.details h2{font-size:21px;line-height:1.65;margin:17px 0 12px}.summary{font-size:13px;line-height:1.95;color:#5f7265}.section{margin-top:23px}.section h3{font-size:12px;color:#7d8b7f;font-weight:600;margin:0 0 10px}.section p{font-size:12px;line-height:1.95;margin:0 0 9px}.source{padding:11px 12px;border:1px solid #dfe7dc;border-radius:6px;background:#f8faf5;margin-top:8px}.source b{font-size:11px;line-height:1.8;color:#5f7762;display:block}.source p{font-size:11px;color:#7b887a;line-height:1.8;margin:5px 0 0}.limit{padding:12px;background:#fbf5e9;border-left:2px solid #ba9a61;border-radius:5px;font-size:12px;line-height:1.9;color:#886e3e}.related{border:0;border-bottom:1px solid #eaf0e7;background:#fff;padding:10px 0;text-align:left;display:block;width:100%;font-size:12px;line-height:1.8;color:#4d755c}.related small{display:block;font-size:11px;color:#8c978b;margin-bottom:3px}.tree-link{border:1px solid #d9e6d8;background:#f2f8ef;border-radius:6px;padding:10px 12px;margin-top:7px;text-align:left;display:block;width:100%;font-size:12px;line-height:1.8;color:#43744f}.state{font-size:11px;padding:5px 8px;background:#f4f5ed;border-radius:4px;color:#8d774e;display:inline-block;margin-top:8px}.actions{display:flex;gap:8px;margin-top:24px}.action{border:1px solid #cdddcd;background:#f3f8ef;border-radius:6px;padding:9px 11px;font-size:12px;color:#42714c}.editor{margin-top:17px;border-top:1px solid var(--border);padding-top:17px}.editor label{display:block;font-size:12px;margin:10px 0 6px}.editor input,.editor textarea{width:100%;padding:9px;border:1px solid var(--border);border-radius:5px;background:#fff;font-size:12px}.editor textarea{min-height:80px;resize:vertical}.editor .action{margin:12px 6px 0 0}.notice{position:fixed;bottom:16px;left:50%;transform:translateX(-50%);background:#254633;color:#fff;padding:10px 15px;font-size:12px;border-radius:6px;z-index:70;max-width:90vw}.hidden{display:none!important}.sr-only{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}@keyframes newNode{0%{box-shadow:0 0 0 7px #7caf9040}100%{box-shadow:0 0 0 0 #7caf9000}}@media(max-width:1000px){.main{padding:20px 17px}.topbar{flex-wrap:wrap;gap:10px}.topbar h1{font-size:21px}.app.open{grid-template-columns:minmax(0,1fr) 310px}.search-wrap{width:180px}.tree-select{max-width:180px}}@media(max-width:720px){.app.open{grid-template-columns:minmax(0,1fr) 0}.main{padding:18px 12px 12px;gap:14px}.topbar h1{flex-basis:100%;font-size:22px}.tree-select{max-width:100%;flex:1}.search-wrap{width:140px;flex:1}.search-results{width:min(350px,90vw)}.toggle{font-size:11px;padding:10px}.details{display:none}.app.open .details{display:block;position:fixed;right:0;bottom:0;left:0;max-height:72vh;z-index:20;border:1px solid var(--border);border-radius:13px 13px 0 0;box-shadow:0 -8px 40px #15372212;padding:22px}.map{min-height:480px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}

.map-shell{position:relative;flex:1;min-height:0}.map-shell>.map{height:100%}.node{width:170px;height:116px;border:0;border-radius:0;background:transparent;box-shadow:none;touch-action:none}.node.root,.node.selected{background:transparent;border:0;box-shadow:none}.node-glyph{position:absolute;inset:0;width:170px;height:116px;overflow:visible;pointer-events:none;filter:drop-shadow(0 3px 7px #21433208);transition:filter .17s}.node-glyph>*{fill:#fff;stroke:#c2d5c7;stroke-width:1.25;transition:fill .16s,stroke .16s,stroke-width .16s}.node.root .node-glyph>*{fill:#edf6ed;stroke:#6eaa87}.node:hover .node-glyph>*{fill:#f4faf2;stroke:#68a284;stroke-width:1.8}.node.selected .node-glyph>*{fill:#eef8ed;stroke:#23765c;stroke-width:2.3}.node.neighbor .node-glyph>*{stroke:#86b59a}.node.selected.neighbor .node-glyph>*{stroke:#23765c}.node.node-dragging{z-index:15}.node.node-dragging .node-glyph{filter:drop-shadow(0 8px 12px #21433228)}.node-main{position:absolute;inset:0;width:100%;height:100%;padding:0;display:grid;place-items:center;background:transparent;cursor:grab;touch-action:none;user-select:none;font-size:15px}.node-main:hover{background:transparent}.node-main>span{display:block;line-height:1.4;overflow-wrap:anywhere;word-break:normal}.node-dragging .node-main{cursor:grabbing}.shared{top:9px;right:-8px}.role-entity .shared{top:0;right:22px}.edge{stroke-linecap:round;transition:stroke-width .14s,opacity .14s}.edge-group.focused .edge{stroke-width:2.8;filter:drop-shadow(0 0 2px #23765c22)}.edge-label:hover rect{stroke-width:1.8;fill:#e9f5e7}.node.located .node-glyph{animation:locatePulse 1.2s ease-out}.node.revised .node-glyph{animation:locatePulse 1.4s ease-out}.layout-tools{position:absolute;top:12px;right:13px;z-index:32}.layout-toggle{padding:8px 12px;border:1px solid var(--border);border-radius:7px;background:#fffffff2;font-size:12px;box-shadow:0 2px 8px #21433206}.layout-toggle.unsaved:after{content:'';display:inline-block;width:6px;height:6px;border-radius:50%;background:#c88b36;margin-left:7px}.layout-panel{position:absolute;right:0;top:39px;width:246px;padding:13px;background:#fff;border:1px solid var(--border);border-radius:9px;box-shadow:0 6px 22px #21433214}.layout-state{display:block;font-size:12px;color:#66816d;margin-bottom:10px}.layout-modes,.layout-actions{display:flex;gap:7px}.layout-modes{margin-bottom:9px}.layout-panel button{flex:1;border:1px solid var(--border);border-radius:6px;background:#fff;padding:8px 6px;font-size:12px}.layout-panel button[aria-pressed=true]{background:#edf6ed;border-color:#79a98a;color:#23765c}.layout-panel button:disabled{opacity:.42;cursor:default}.layout-actions #save-layout:not(:disabled){background:#23765c;color:#fff;border-color:#23765c}.editor select{width:100%;padding:9px;border:1px solid var(--border);border-radius:6px;background:#fff;font-size:13px}@keyframes locatePulse{0%{filter:drop-shadow(0 0 0 #23765c)}35%{filter:drop-shadow(0 0 9px #23765c66)}100%{filter:drop-shadow(0 3px 7px #21433208)}}@media(max-width:650px){.layout-tools{top:9px;right:9px}.layout-panel{width:225px}}@media(prefers-reduced-motion:reduce){.node-glyph,.node-glyph>*,.edge{transition:none!important;animation:none!important}}
.node.node-collision .node-glyph>*{stroke:#bf7256;fill:#fff3ec;stroke-width:2.4}.topbar h1{overflow-wrap:anywhere}@media(max-width:1200px){.app.open .topbar{flex-wrap:wrap}.app.open .topbar h1{flex-basis:100%}}@media(max-width:720px){.tree-select{flex:1 1 100%;width:100%;max-width:100%}.search-wrap{flex:1 1 140px;min-width:140px}}.history-files{margin-top:8px}.layout-actions{flex-wrap:wrap}#save-layout{flex-basis:100%}.layout-actions button{min-width:80px}#layout-state{line-height:1.6}.detail-controls{display:flex;border:1px solid var(--border);border-radius:7px;overflow:hidden;background:#fff;flex-shrink:0}.detail-controls button{border:0;border-right:1px solid var(--border);background:#fff;padding:10px 11px;font-size:12px}.detail-controls button:last-child{border-right:0}.detail-controls button[aria-pressed=true]{background:#edf6ed;color:#23765c}.detail-controls button:focus-visible{outline-offset:-3px}.app{height:100vh;height:100dvh;overflow:hidden}.main{min-height:0}.map-shell{min-height:0;flex:1 1 0}.map-shell>.map{position:absolute;inset:0;height:auto;min-height:0;overflow:hidden;cursor:grab;touch-action:none}.extent{position:absolute;inset:0;width:100%!important;height:100%!important;margin:0;min-height:0;pointer-events:none}.board{position:absolute;left:0;top:0;pointer-events:none}.node,.edge-label{pointer-events:auto}.camera-tools{position:absolute;bottom:12px;left:13px;z-index:18;display:flex;align-items:center;border:1px solid var(--border);border-radius:8px;background:#fffffff2;box-shadow:0 2px 8px #21433209;overflow:hidden}.camera-tools button{border:0;background:transparent;min-width:35px;height:35px;padding:0 10px;font-size:17px}.camera-tools button:hover{background:var(--soft)}.camera-tools button:disabled{opacity:.35;cursor:default}.camera-tools output{min-width:48px;text-align:center;font-size:11px;font-variant-numeric:tabular-nums}.camera-tools #center-map{font-size:12px;border-left:1px solid var(--border);padding:0 12px}.camera-tools button:focus-visible{outline-offset:-3px}@media(max-width:650px){.camera-tools{bottom:9px;left:9px}}
:root{--focus-in:#356ecc;--focus-out:#147c62;--focus-self:#8657bf;--focus-neutral:#64748b}.direction-incoming{--direction-color:var(--focus-in)}.direction-outgoing{--direction-color:var(--focus-out)}.direction-self{--direction-color:var(--focus-self)}.direction-undirected{--direction-color:var(--focus-neutral)}.edge-halo{fill:none;stroke:#fcfdfa;stroke-width:7;stroke-linecap:round;vector-effect:non-scaling-stroke;pointer-events:none}.edge-group.focused .edge{stroke-width:3;vector-effect:non-scaling-stroke;filter:none}.edge-group[data-direction]:not([data-direction=""]) .edge{stroke:var(--direction-color)}.edge-group[data-direction]:not([data-direction=""]) .edge-label rect{stroke:var(--direction-color);stroke-width:1.2;fill:#fff}.edge-group[data-direction]:not([data-direction=""]) .edge-label text{fill:var(--direction-color);font-weight:600}.map.node-focus .edge-group.dim{opacity:.10}.map.node-focus .node.dim{opacity:.28}.edge-group.focused:hover .edge,.edge-group.focused:focus-within .edge{stroke-width:4.2}.node.neighbor:not(.selected) .node-glyph>*{stroke:var(--direction-color,#86b59a);stroke-width:2}.node.neighbor.direction-both:not(.selected) .node-glyph>*{stroke:url(#focus-both);stroke-width:2.4}.connection-groups{margin-top:18px}.connection-group{border-left:3px solid var(--direction-color);padding:0 0 0 11px;margin-top:16px}.connection-group h4{font-size:12px;line-height:1.6;margin:0 0 4px;color:var(--direction-color);font-weight:600}.connection-group .related{padding:8px 0;color:var(--ink)}.connection-group .related small{color:var(--direction-color)}.connection-group .related span{display:block;overflow-wrap:anywhere}.connection-group .related:hover{background:#f8faf6}
@media(max-width:720px){.app.open .details{height:44vh;height:44dvh;max-height:44vh;max-height:44dvh}.app.open .main{padding-bottom:calc(44vh + 12px);padding-bottom:calc(44dvh + 12px)}}.board{--map-zoom:1}.board .node{width:calc(170px * var(--map-zoom));height:calc(116px * var(--map-zoom))}.board .node-glyph{width:100%;height:100%}.board .node-main{font-size:calc(15px * var(--map-zoom))}.board .shared{top:calc(21.5px * var(--map-zoom) - 12.5px);right:calc(7px * var(--map-zoom) - 15px)}.board .role-entity .shared{top:calc(12.5px * var(--map-zoom) - 12.5px);right:calc(37px * var(--map-zoom) - 15px)}</style></head><body><div class="app" id="app"><main class="main"><div class="topbar"><h1 id="paper-title">Paper title</h1><label class="sr-only" for="tree">Select tree</label><select class="tree-select" id="tree"></select><div class="search-wrap"><label class="sr-only" for="search">Search nodes</label><input class="search" type="search" id="search" placeholder="Search nodes" autocomplete="off"><div class="search-results hidden" id="search-results" aria-label="Node search results"></div></div><div class="detail-controls" id="detail-controls" role="group" aria-label="Detail level"><button id="detail-low" aria-pressed="false">Low</button><button id="detail-medium" aria-pressed="false">Medium</button><button id="detail-high" aria-pressed="true">High</button></div></div><div class="map-shell"><section class="map" id="map" tabindex="0" aria-label="Concept graph with arbitrary node extensions"><div class="extent" id="extent"><div class="board" id="board"><svg class="edges" id="edges" aria-label="Node relationships"><defs><marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0 L10 5 L0 10 z" fill="#9ab19f"></path></marker><marker id="support-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0 L10 5 L0 10 z" fill="#23765c"></path></marker><marker id="causal-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0 L10 5 L0 10 z" fill="#5c7d92"></path></marker><marker id="inhibit" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M8 0 L8 10" stroke="#5c7d92" stroke-width="2"></path></marker><linearGradient id="focus-both" x1="0%" x2="100%"><stop offset="50%" stop-color="#356ecc"/><stop offset="50%" stop-color="#147c62"/></linearGradient><marker id="focus-incoming-arrow" viewBox="0 0 12 12" refX="11" refY="6" markerWidth="5.5" markerHeight="5.5" orient="auto"><path d="M1 1 L11 6 L1 11 Z" fill="#356ecc" stroke="#fcfdfa" stroke-width=".5"/></marker><marker id="focus-incoming-inhibit" viewBox="0 0 12 12" refX="10" refY="6" markerWidth="5.5" markerHeight="5.5" orient="auto"><path d="M10 1 L10 11" fill="none" stroke="#356ecc" stroke-width="2.2"/></marker><marker id="focus-outgoing-arrow" viewBox="0 0 12 12" refX="11" refY="6" markerWidth="5.5" markerHeight="5.5" orient="auto"><path d="M1 1 L11 6 L1 11 Z" fill="#147c62" stroke="#fcfdfa" stroke-width=".5"/></marker><marker id="focus-outgoing-inhibit" viewBox="0 0 12 12" refX="10" refY="6" markerWidth="5.5" markerHeight="5.5" orient="auto"><path d="M10 1 L10 11" fill="none" stroke="#147c62" stroke-width="2.2"/></marker><marker id="focus-self-arrow" viewBox="0 0 12 12" refX="11" refY="6" markerWidth="5.5" markerHeight="5.5" orient="auto"><path d="M1 1 L11 6 L1 11 Z" fill="#8657bf" stroke="#fcfdfa" stroke-width=".5"/></marker><marker id="focus-self-inhibit" viewBox="0 0 12 12" refX="10" refY="6" markerWidth="5.5" markerHeight="5.5" orient="auto"><path d="M10 1 L10 11" fill="none" stroke="#8657bf" stroke-width="2.2"/></marker></defs><g id="edge-layer"></g></svg><div id="nodes"></div></div></div></section><div class="camera-tools" role="group" aria-label="Canvas navigation"><button id="zoom-out" aria-label="Zoom out">−</button><output id="zoom-value" aria-live="off">100%</output><button id="zoom-in" aria-label="Zoom in">+</button><button id="center-map">Center</button></div><div class="layout-tools"><button class="layout-toggle" id="layout-toggle" aria-expanded="false" aria-controls="layout-panel">Layout</button><div class="layout-panel hidden" id="layout-panel"><output class="layout-state" id="layout-state" aria-live="polite"></output><div class="layout-modes"><button id="curve-mode" aria-pressed="true">Curves</button><button id="straight-mode" aria-pressed="false">Straight</button></div><div class="layout-actions"><button id="previous-save">Prev</button><button id="next-save">Next</button><button id="save-layout">Save</button></div><div class="layout-actions history-files"><button id="import-history">Import history</button><button id="save-copy">Save copy</button></div></div></div><input type="file" id="history-file" accept="application/json,.json" hidden></div></main><aside class="details" id="details" aria-label="Node and relationship details"></aside></div><div class="notice hidden" id="notice" role="status"></div>
<script id="bootstrap" type="application/json">__BOOTSTRAP__</script><script>
__RUNTIME__
</script></body></html>

<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Paper title</title><style>
:root{--bg:#f7f8f4;--ink:#233930;--muted:#77847b;--border:#dce4dc;--accent:#23765c;--soft:#edf5ed;--blue:#5c7d92}*{box-sizing:border-box}body{margin:0;color:var(--ink);background:var(--bg);font-family:Inter,"Segoe UI","Microsoft JhengHei",sans-serif}button,input,select,textarea{font:inherit;color:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #7bb497;outline-offset:3px}.app{height:100vh;display:grid;grid-template-columns:minmax(0,1fr) 0;transition:grid-template-columns .18s}.app.open{grid-template-columns:minmax(0,1fr) 350px}.main{min-width:0;padding:25px 25px 20px;display:flex;flex-direction:column;gap:19px}.topbar{display:flex;align-items:center;gap:13px;min-height:43px}.topbar h1{font-size:24px;font-weight:600;margin:0;line-height:1.5;flex:1;min-width:0;letter-spacing:.025em}.tree-select{max-width:230px;padding:10px 11px;border:1px solid var(--border);border-radius:6px;background:#fff;font-size:12px}.search-wrap{position:relative;width:210px}.search{width:100%;padding:10px 12px;border:1px solid var(--border);border-radius:6px;background:#fff;font-size:12px}.search-results{position:absolute;right:0;top:44px;width:350px;max-height:420px;overflow:auto;border:1px solid #cddcce;border-radius:7px;background:#fff;z-index:50;box-shadow:0 9px 30px #163d2217}.search-result{display:block;text-align:left;width:100%;padding:13px 15px;border:0;border-bottom:1px solid #eef2eb;background:#fff;font-size:13px}.search-result:hover{background:#f1f7ed}.search-result span{display:block;font-size:11px;line-height:1.8;color:#7d8c7d;margin-top:4px}.empty-result{font-size:12px;line-height:1.8;padding:15px;color:var(--muted)}.toggle{padding:10px 13px;white-space:nowrap;background:#fff;border:1px solid var(--border);border-radius:6px;font-size:12px}.toggle[aria-pressed=true]{background:var(--soft);border-color:#83af94;color:var(--accent)}.map{position:relative;flex:1;min-height:0;border:1px solid var(--border);border-radius:10px;overflow:auto;background:#fcfdfa;background-image:radial-gradient(#d2ddcf .75px,transparent .75px);background-size:20px 20px;scrollbar-width:thin;scrollbar-color:#bdcdbd transparent;overscroll-behavior:contain}.map.dragging{cursor:grabbing;user-select:none}.extent{position:relative;margin:auto;min-height:100%}.board{position:relative;transform-origin:0 0}.edges{position:absolute;inset:0;overflow:visible;pointer-events:none}.edge{fill:none;stroke:#aabeb0;stroke-width:1.7}.edge.support{stroke:var(--accent);stroke-width:2}.edge.causal{stroke:var(--blue);stroke-width:2}.edge.limitation{stroke:#a58c65}.edge.unconfirmed{stroke-dasharray:6 4}.edge-group.dim{opacity:.15}.edge-group.selected .edge{stroke-width:3}.edge-label{pointer-events:auto;cursor:pointer}.edge-label rect{fill:#fcfdfa;stroke:#d9e3d8;stroke-width:.9;rx:5}.edge-label text{fill:#5c7162;font:11px "Segoe UI","Microsoft JhengHei",sans-serif;text-anchor:middle;dominant-baseline:middle;pointer-events:none}.edge-label:hover rect,.edge-label:focus rect,.edge-group.selected rect{fill:#eaf4e9;stroke:#7d9f84}.node{position:absolute;width:170px;height:62px;border:1px solid #cbdacf;border-radius:8px;background:#fff;box-shadow:0 3px 12px #21433204;transition:opacity .16s,border-color .16s}.node.root{background:#edf6ed;border-color:#6eaa87}.node.selected{border-color:var(--accent);box-shadow:0 0 0 2px #23765c19;background:#f4faf2}.node.dim{opacity:.2}.node-main{width:100%;height:100%;border:0;border-radius:8px;background:transparent;padding:10px 15px;font-size:16px;font-weight:600;line-height:1.45;letter-spacing:.015em;text-align:center}.node-main:hover{background:#f2f8ef}.shared{position:absolute;top:-12px;right:-10px;min-width:30px;height:25px;background:#fff;border:1px solid #b4cfbb;border-radius:13px;color:#367f50;font-size:11px;padding:2px 6px;z-index:2}.shared:hover{background:#e5f3e7}.new-node{animation:newNode 1.8s ease-out}.revised{border-style:dashed}.details{min-width:0;overflow:auto;background:#fff;padding:0;visibility:hidden}.app.open .details{border-left:1px solid var(--border);padding:24px 21px;visibility:visible}.detail-top{display:flex;align-items:center;justify-content:space-between;gap:10px}.kind{font-size:11px;color:var(--accent);background:var(--soft);padding:5px 8px;border-radius:4px}.close{border:1px solid var(--border);border-radius:5px;background:#fff;padding:5px 9px;font-size:13px}.details h2{font-size:21px;line-height:1.65;margin:17px 0 12px}.summary{font-size:13px;line-height:1.95;color:#5f7265}.section{margin-top:23px}.section h3{font-size:12px;color:#7d8b7f;font-weight:600;margin:0 0 10px}.section p{font-size:12px;line-height:1.95;margin:0 0 9px}.source{padding:11px 12px;border:1px solid #dfe7dc;border-radius:6px;background:#f8faf5;margin-top:8px}.source b{font-size:11px;line-height:1.8;color:#5f7762;display:block}.source p{font-size:11px;color:#7b887a;line-height:1.8;margin:5px 0 0}.limit{padding:12px;background:#fbf5e9;border-left:2px solid #ba9a61;border-radius:5px;font-size:12px;line-height:1.9;color:#886e3e}.related{border:0;border-bottom:1px solid #eaf0e7;background:#fff;padding:10px 0;text-align:left;display:block;width:100%;font-size:12px;line-height:1.8;color:#4d755c}.related small{display:block;font-size:11px;color:#8c978b;margin-bottom:3px}.tree-link{border:1px solid #d9e6d8;background:#f2f8ef;border-radius:6px;padding:10px 12px;margin-top:7px;text-align:left;display:block;width:100%;font-size:12px;line-height:1.8;color:#43744f}.state{font-size:11px;padding:5px 8px;background:#f4f5ed;border-radius:4px;color:#8d774e;display:inline-block;margin-top:8px}.actions{display:flex;gap:8px;margin-top:24px}.action{border:1px solid #cdddcd;background:#f3f8ef;border-radius:6px;padding:9px 11px;font-size:12px;color:#42714c}.editor{margin-top:17px;border-top:1px solid var(--border);padding-top:17px}.editor label{display:block;font-size:12px;margin:10px 0 6px}.editor input,.editor textarea{width:100%;padding:9px;border:1px solid var(--border);border-radius:5px;background:#fff;font-size:12px}.editor textarea{min-height:80px;resize:vertical}.editor .action{margin:12px 6px 0 0}.notice{position:fixed;bottom:16px;left:50%;transform:translateX(-50%);background:#254633;color:#fff;padding:10px 15px;font-size:12px;border-radius:6px;z-index:70;max-width:90vw}.hidden{display:none!important}.sr-only{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}@keyframes newNode{0%{box-shadow:0 0 0 7px #7caf9040}100%{box-shadow:0 0 0 0 #7caf9000}}@media(max-width:1000px){.main{padding:20px 17px}.topbar{flex-wrap:wrap;gap:10px}.topbar h1{font-size:21px}.app.open{grid-template-columns:minmax(0,1fr) 310px}.search-wrap{width:180px}.tree-select{max-width:180px}}@media(max-width:720px){.app.open{grid-template-columns:minmax(0,1fr) 0}.main{padding:18px 12px 12px;gap:14px}.topbar h1{flex-basis:100%;font-size:22px}.tree-select{max-width:100%;flex:1}.search-wrap{width:140px;flex:1}.search-results{width:min(350px,90vw)}.toggle{font-size:11px;padding:10px}.details{display:none}.app.open .details{display:block;position:fixed;right:0;bottom:0;left:0;max-height:72vh;z-index:20;border:1px solid var(--border);border-radius:13px 13px 0 0;box-shadow:0 -8px 40px #15372212;padding:22px}.map{min-height:480px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style></head><body><div class="app" id="app"><main class="main"><div class="topbar"><h1 id="paper-title">Paper title</h1><label class="sr-only" for="tree">Select tree</label><select class="tree-select" id="tree"></select><div class="search-wrap"><label class="sr-only" for="search">Search nodes</label><input class="search" type="search" id="search" placeholder="Search nodes" autocomplete="off"><div class="search-results hidden" id="search-results" aria-label="Node search results"></div></div><button class="toggle" id="all" aria-pressed="false">All relations</button></div><section class="map" id="map" tabindex="0" aria-label="Concept graph with arbitrary node extensions"><div class="extent" id="extent"><div class="board" id="board"><svg class="edges" id="edges" aria-label="Node relationships"><defs><marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0 L10 5 L0 10 z" fill="#9ab19f"></path></marker><marker id="support-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0 L10 5 L0 10 z" fill="#23765c"></path></marker><marker id="causal-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0 L10 5 L0 10 z" fill="#5c7d92"></path></marker><marker id="inhibit" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M8 0 L8 10" stroke="#5c7d92" stroke-width="2"></path></marker></defs><g id="edge-layer"></g></svg><div id="nodes"></div></div></div></section></main><aside class="details" id="details" aria-label="Node and relationship details"></aside></div><div class="notice hidden" id="notice" role="status"></div>
<script id="bootstrap" type="application/json">__BOOTSTRAP__</script><script>
'use strict';

const $=id=>document.getElementById(id),clone=x=>JSON.parse(JSON.stringify(x)),BOOT=JSON.parse($('bootstrap').textContent),TYPES={"question": "Research question", "concept": "Concept", "hypothesis": "Hypothesis", "experiment": "Experiment", "observation": "Observation", "claim": "Claim", "limit": "Limitation", "definition": "Definition", "theorem": "Theorem", "proof": "Proof", "algorithm": "Algorithm", "assumption": "Assumption", "dataset": "Dataset", "model": "Model", "metric": "Metric", "counterexample": "Counterexample", "method": "Method", "finding": "Finding", "argument": "Argument", "source": "Material", "interpretation": "Interpretation"},STATUS={"supported": "Supported by evidence", "hypothesis": "Hypothesis", "unresolved": "Unresolved", "inferred": "Evidence-based inference", "design": "Research design or reading context", "disputed": "Disputed evidence", "user": "User note, not yet checked"};
let state=clone(BOOT),activeTree='main',all=false,query='',selected=null,zoom=1,manualZoom=false,newIds=new Set(),changedIds=new Set(),pan=null,sourceUnavailable=false,noticeTimer;
const esc=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),storageKey='paper-map-session:'+state.paper.id;
function validate(s){if(!s||s.schemaVersion!==2||!s.paper||!s.graph||!Array.isArray(s.graph.nodes)||!Array.isArray(s.graph.links)||!Array.isArray(s.graph.trees)||!s.graph.relationTypes||!s.graph.locale)throw Error('Incomplete localized session');const ids=new Set(),edges=new Set();for(const n of s.graph.nodes){if(!n.id||ids.has(n.id)||!(TYPES[n.type]||s.graph.nodeTypes?.[n.type])||!n.label||!n.title)throw Error('Invalid node');ids.add(n.id)}for(const e of s.graph.links){if(!e.id||edges.has(e.id)||!ids.has(e.from)||!ids.has(e.to)||!s.graph.relationTypes[e.relationType]||!e.label||!e.meaning||!STATUS[e.status])throw Error('Invalid relationship');edges.add(e.id)}for(const t of s.graph.trees){if(!t.id||!t.title||!Array.isArray(t.nodeIds)||!Array.isArray(t.linkIds)||!t.nodeIds.includes(t.rootId)||t.nodeIds.some(id=>!ids.has(id))||t.linkIds.some(id=>!edges.has(id)))throw Error('Invalid tree');for(const id of t.nodeIds){const p=t.positions?.[id];if(!p||!Number.isFinite(p.x)||!Number.isFinite(p.y)||p.x<0||p.y<0)throw Error('Invalid position')}for(const id of t.linkIds){const e=s.graph.links.find(e=>e.id===id);if(!t.nodeIds.includes(e.from)||!t.nodeIds.includes(e.to))throw Error('Endpoints outside view')}}return true}
function ui(key,args={}){let text=state.graph.locale.ui[key];if(typeof text!=='string')throw Error('Missing locale key: '+key);return text.replace(/\{(\w+)\}/g,(_,k)=>args[k]??'{'+k+'}')}
function applyLocale(){if(document.documentElement)document.documentElement.lang=state.graph.locale.languageTag;$('search').placeholder=ui('search');$('all').textContent=ui('allRelations');$('search-results').setAttribute('aria-label',ui('searchResults'));$('map').setAttribute('aria-label',ui('mapLabel'));$('edges').setAttribute('aria-label',ui('edgeLabel'));$('details').setAttribute('aria-label',ui('detailLabel'));document.querySelectorAll('label[for="tree"]').forEach(el=>el.textContent=ui('selectTree'));document.querySelectorAll('label[for="search"]').forEach(el=>el.textContent=ui('search'))}

let canonicalRevision=BOOT.revision,localDraftRevision=0;
function persist(){try{localStorage.setItem(storageKey,JSON.stringify({baseRevision:canonicalRevision,draftRevision:localDraftRevision,draftState:state}))}catch(error){notice(ui('draftUnavailable'))}}
function notice(message){$('notice').textContent=message;$('notice').classList.remove('hidden');clearTimeout(noticeTimer);noticeTimer=setTimeout(()=>$('notice').classList.add('hidden'),4000)}
const node=id=>state.graph.nodes.find(n=>n.id===id),edge=id=>state.graph.links.find(e=>e.id===id),tree=()=>state.graph.trees.find(t=>t.id===activeTree)||state.graph.trees[0],memberships=id=>state.graph.trees.filter(t=>t.nodeIds.includes(id)),position=id=>tree().positions[id];
function displayLabel(e){const base=e.displayLabel||state.graph.locale.relationLabels[e.relationType]||e.label;return base+(e.displayStatusSuffix??({hypothesis:ui('hypothesisSuffix'),user:ui('userSuffix'),disputed:ui('disputedSuffix')}[e.status]||''))}
function matches(){const q=query.trim().toLowerCase();if(!q)return[];return state.graph.nodes.filter(n=>memberships(n.id).length&&(n.label+' '+n.title+' '+(n.aliases||[]).join(' ')+' '+(n.detail||'')).toLowerCase().includes(q))}
function searchResults(){const q=query.trim();$('search-results').classList.toggle('hidden',!q);if(!q)return;const list=matches();$('search-results').innerHTML=list.length?list.map(n=>`<button class="search-result" data-search-node="${esc(n.id)}"><b>${esc(n.label)}</b><span>${memberships(n.id).map(t=>esc(t.id==='main'?ui('mainTree'):t.title)).join(' · ')}</span></button>`).join(''):`<div class="empty-result">${esc(ui('noResults'))}</div>`;document.querySelectorAll('[data-search-node]').forEach(el=>el.onclick=()=>locate(el.dataset.searchNode))}
function render(){applyLocale();const t=tree(),match=query.trim()?new Set(matches().map(n=>n.id)):null;$('paper-title').textContent=t.id==='main'?state.paper.title:t.title;document.title=$('paper-title').textContent;$('tree').innerHTML=state.graph.trees.map(v=>`<option value="${esc(v.id)}" ${v.id===t.id?'selected':''}>${esc(v.id==='main'?ui('mainTree'):v.title)}</option>`).join('');$('tree').classList.toggle('hidden',state.graph.trees.length<2);$('all').setAttribute('aria-pressed',all);$('nodes').innerHTML=t.nodeIds.map(id=>{const n=node(id),p=position(id),views=memberships(id);return `<article class="node ${id===t.rootId?'root':''} ${selected?.kind==='node'&&selected.id===id?'selected':''} ${match&&!match.has(id)?'dim':''} ${newIds.has(id)?'new-node':''} ${changedIds.has(id)?'revised':''}" style="left:${p.x}px;top:${p.y}px" data-card="${esc(id)}"><button class="node-main" data-node="${esc(id)}" aria-label="${esc(n.label)}">${esc(n.label)}</button>${views.length>1?`<button class="shared" data-shared="${esc(id)}" aria-label="${esc(ui('sharedCount',{name:n.label,count:views.length}))}">↗ ${views.length}</button>`:''}</article>`}).join('');$('edge-layer').innerHTML=t.linkIds.map(edge).filter(e=>all||e.primary!==false).map(e=>{const r=state.graph.relationTypes[e.relationType],p=route(e),text=displayLabel(e),w=Math.max(42,text.length*11+14),marker=r.directed===false?'':r.marker==='inhibit'?'inhibit':r.family==='causal'?'causal-arrow':r.family==='evidence'?'support-arrow':'arrow',style=r.family==='causal'?'causal':r.family==='evidence'?'support':['limitation','boundary'].includes(r.family)?'limitation':'',status=['hypothesis','unresolved','user'].includes(e.status)?'unconfirmed':'';return `<g class="edge-group ${selected?.kind==='edge'&&selected.id===e.id?'selected':''} ${match&&(!match.has(e.from)||!match.has(e.to))?'dim':''}"><path class="edge ${style} ${status}" d="${esc(p.d)}" ${marker?`marker-end="url(#${marker})"`:''}></path><g class="edge-label" tabindex="0" role="button" data-edge="${esc(e.id)}" aria-label="${esc(ui('relationshipAria',{name:text}))}"><rect x="${p.x-w/2}" y="${p.y-12}" width="${w}" height="24"></rect><text x="${p.x}" y="${p.y+1}">${esc(text)}</text></g></g>`}).join('');document.querySelectorAll('[data-node]').forEach(el=>el.onclick=()=>select('node',el.dataset.node));document.querySelectorAll('[data-shared]').forEach(el=>el.onclick=()=>{select('node',el.dataset.shared);$('other-trees')?.scrollIntoView({block:'nearest'})});document.querySelectorAll('[data-edge]').forEach(el=>{el.onclick=()=>select('edge',el.dataset.edge);el.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();select('edge',el.dataset.edge)}}});if(selected)details();resize()}
function route(e){const custom=tree().routes?.[e.id];if(custom)return custom;const a=position(e.from),b=position(e.to),ax=a.x+85,ay=a.y+31,bx=b.x+85,by=b.y+31,dx=bx-ax,dy=by-ay;const reverse=tree().linkIds.map(edge).some(x=>x.from===e.to&&x.to===e.from&&x.id!==e.id);if(e.from===e.to)return{d:`M${ax-40} ${a.y} C${ax-80} ${a.y-100} ${ax+80} ${a.y-100} ${ax+40} ${a.y}`,x:ax,y:a.y-78};if(reverse){const side=dx>=0?1:-1,sx=ax,sy=a.y+(side>0?0:62),tx=bx,ty=b.y+(side>0?0:62),offset=side>0?-95:95;return{d:`M${sx} ${sy} C${sx} ${sy+offset} ${tx} ${ty+offset} ${tx} ${ty}`,x:(sx+tx)/2,y:(sy+ty)/2+offset*.75}}if(Math.abs(dx)>Math.abs(dy)){const sx=a.x+(dx>=0?170:0),tx=b.x+(dx>=0?0:170),mx=(sx+tx)/2;return{d:`M${sx} ${ay} C${mx} ${ay} ${mx} ${by} ${tx} ${by}`,x:mx,y:(ay+by)/2}}const sy=a.y+(dy>=0?62:0),ty=b.y+(dy>=0?0:62),my=(sy+ty)/2;return{d:`M${ax} ${sy} C${ax} ${my} ${bx} ${my} ${bx} ${ty}`,x:(ax+bx)/2,y:my}}
function sources(refs){return refs?.length?refs.map(r=>{const s=state.sources.find(s=>s.id===r.sourceId);return `<div class="source"><b>${esc(s?.label||r.sourceId)} · ${esc(r.location)}</b><p>${esc(r.excerpt||s?.note||'')}</p></div>`}).join(''):`<p>${esc(ui('noEvidence'))}</p>`}
function details(){if(!selected)return;let html='';if(selected.kind==='node'){const n=node(selected.id);if(!n){close();return}const links=tree().linkIds.map(edge).filter(e=>e.from===n.id||e.to===n.id),views=memberships(n.id).filter(t=>t.id!==activeTree),terms=state.glossary.filter(t=>(n.termIds||[]).includes(t.id));html=`<div class="detail-top"><span class="kind">${esc(state.graph.locale.nodeTypes[n.type]||n.type)}</span><button class="close" id="close" aria-label="${esc(ui('close'))}">×</button></div><h2>${esc(n.label)}</h2><p class="summary">${esc(n.detail||n.title)}</p>${terms.length?`<div class="section"><h3>${esc(ui('definitions'))}</h3>${terms.map(t=>`<p><b>${esc(t.targetTerm||t.term||t.en||'')} · ${esc(t.sourceTerm||t.en||'')}</b><br>${esc(t.definition)}</p>`).join('')}</div>`:''}${views.length?`<div class="section" id="other-trees"><h3>${esc(ui('sharedHeading'))}</h3>${views.map(t=>`<button class="tree-link" data-tree-link="${esc(t.id)}" data-shared-id="${esc(n.id)}">${esc(t.id==='main'?state.paper.title:t.title)}</button>`).join('')}</div>`:''}<div class="section"><h3>${esc(ui('sources'))}</h3>${sources(n.sourceRefs)}</div>${n.limits?`<div class="section"><h3>${esc(ui('limits'))}</h3><div class="limit">${esc(n.limits)}</div></div>`:''}<div class="section"><h3>${esc(ui('connectedNodes'))}</h3>${links.map(e=>`<button class="related" data-related="${esc(e.id)}"><small>${esc(displayLabel(e))}</small>${esc(node(e.from===n.id?e.to:e.from)?.label)}</button>`).join('')}</div><div class="actions"><button class="action" id="extend">${esc(ui('extend'))}</button><button class="action" id="new-tree">${esc(ui('newTree'))}</button></div><div id="editor"></div>`}
else{const e=edge(selected.id);if(!e){close();return}const r=state.graph.relationTypes[e.relationType],conditions=e.context||JSON.stringify(e.qualifiers||{});html=`<div class="detail-top"><span class="kind">${esc(state.graph.locale.families[r.family]||r.family)}</span><button class="close" id="close" aria-label="${esc(ui('close'))}">×</button></div><h2>${esc(displayLabel(e))}</h2><p class="summary">${esc(e.meaning)}</p><div class="state">${esc(state.graph.locale.statuses[e.status])}</div><div class="section"><h3>${esc(ui('relationDefinition'))}</h3><p>${esc(state.graph.locale.relationDefinitions[e.relationType])}</p><p>${esc(ui(r.directed===false?'undirected':'directed'))}</p></div>${conditions&&conditions!=='{}'?`<div class="section"><h3>${esc(ui('conditions'))}</h3><p>${esc(conditions)}</p></div>`:''}<div class="section"><h3>${esc(ui('connectedNodes'))}</h3><button class="related" data-node-link="${esc(e.from)}"><small>${esc(ui('sourceNode'))}</small>${esc(node(e.from).label)}</button><button class="related" data-node-link="${esc(e.to)}"><small>${esc(ui('targetNode'))}</small>${esc(node(e.to).label)}</button></div><div class="section"><h3>${esc(ui('basis'))}</h3>${sources(e.sourceRefs)}</div><div class="section"><h3>${esc(ui('caution'))}</h3><div class="limit">${esc(ui('relationCaveat'))}</div></div>`}
$('details').innerHTML=html;$('close').onclick=close;document.querySelectorAll('[data-related]').forEach(el=>el.onclick=()=>select('edge',el.dataset.related));document.querySelectorAll('[data-node-link]').forEach(el=>el.onclick=()=>locate(el.dataset.nodeLink));document.querySelectorAll('[data-tree-link]').forEach(el=>el.onclick=()=>changeTree(el.dataset.treeLink,el.dataset.sharedId));if($('extend'))$('extend').onclick=()=>editor('extend');if($('new-tree'))$('new-tree').onclick=()=>editor('tree')}
function select(kind,id){selected={kind,id};$('app').classList.add('open');render();if(!manualZoom)requestAnimationFrame(fit)}function close(){selected=null;$('app').classList.remove('open');render();if(!manualZoom)requestAnimationFrame(fit)}
function changeTree(id,sharedId){activeTree=id;all=false;manualZoom=false;selected=sharedId?{kind:'node',id:sharedId}:null;$('app').classList.toggle('open',!!selected);render();requestAnimationFrame(()=>{fit();if(sharedId)centerNode(sharedId)})}
function locate(id){const v=memberships(id),target=v.find(t=>t.id===activeTree)||v.find(t=>t.id==='main')||v[0];if(!target)return;activeTree=target.id;selected={kind:'node',id};$('app').classList.add('open');$('search-results').classList.add('hidden');manualZoom=false;render();requestAnimationFrame(()=>{fit();centerNode(id)})}
function centerNode(id){const card=document.querySelector(`[data-card="${CSS.escape(id)}"]`);if(!card)return;const r=card.getBoundingClientRect(),m=$('map').getBoundingClientRect();$('map').scrollBy({left:r.left+r.width/2-m.left-m.width/2,top:r.top+r.height/2-m.top-m.height/2,behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'instant':'smooth'})}
function geometry(){const ps=tree().nodeIds.map(position),rs=tree().linkIds.map(edge).map(route);return{width:Math.max(980,...ps.map(p=>p.x+210),...rs.map(p=>p.bounds?.maxX||p.x+80)),height:Math.max(650,...ps.map(p=>p.y+120),...rs.map(p=>p.bounds?.maxY||p.y+90))}}
function resize(){const g=geometry();$('board').style.width=g.width+'px';$('board').style.height=g.height+'px';$('board').style.transform=`scale(${zoom})`;$('edges').setAttribute('width',g.width);$('edges').setAttribute('height',g.height);$('extent').style.width=g.width*zoom+'px';$('extent').style.height=g.height*zoom+'px'}function fit(){const g=geometry();zoom=Math.max(.65,Math.min(1.3,($('map').clientWidth-24)/g.width,($('map').clientHeight-28)/g.height));resize()}
function freeSpot(id){const base=position(id),occupied=tree().nodeIds.map(position),angles=[0,.65,-.65,1.3,-1.3,Math.PI,.65+Math.PI,-.65+Math.PI];for(let radius=310;radius<2200;radius+=150)for(const angle of angles){const p={x:Math.round(base.x+Math.cos(angle)*radius),y:Math.round(base.y+Math.sin(angle)*radius)};if(p.x<30||p.y<40)continue;if(occupied.every(q=>Math.abs(q.x-p.x)>210||Math.abs(q.y-p.y)>115))return p}return{x:base.x+220,y:Math.max(...occupied.map(p=>p.y))+160}}
function editor(mode){const root=node(selected.id);$('editor').innerHTML=`<form class="editor" id="edit-form"><label for="new-label">${esc(ui(mode==='tree'?'newTreeName':'newNodeName'))}</label><input id="new-label" required maxlength="80" value="${mode==='tree'?esc(ui('extendedContext',{name:root.label})):''}">${mode==='extend'?`<label for="new-relation">${esc(ui('relation'))}</label><input id="new-relation" required value="${esc(state.graph.locale.relationLabels.requires_concept||state.graph.locale.relationLabels.note)}"><label for="new-detail">${esc(ui('detail'))}</label><textarea id="new-detail"></textarea>`:''}<button class="action" type="submit">${esc(ui(mode==='tree'?'create':'connect'))}</button><button class="action" type="button" id="cancel">${esc(ui('cancel'))}</button></form>`;$('new-label').focus();$('cancel').onclick=()=>$('editor').innerHTML='';$('edit-form').onsubmit=e=>{e.preventDefault();const text=$('new-label').value.trim();if(!text)return;const id=(crypto.randomUUID?.()||Date.now().toString()).replaceAll('-','');if(mode==='tree'){const v={id:'tree-'+id,title:text,focusQuestion:text,rootId:root.id,nodeIds:[root.id],linkIds:[],positions:{[root.id]:{x:400,y:220}},routes:{}};state.graph.trees.push(v);localDraftRevision++;persist();changeTree(v.id,root.id)}else{const relation=$('new-relation').value.trim(),detail=$('new-detail').value.trim();if(!relation)return;const n={id:'node-'+id,label:text,title:text,type:'concept',detail:detail||ui('draftDetail'),limits:ui('draftLimits'),sourceRefs:[],termIds:[],aliases:[],provenance:'user-note'},p=freeSpot(root.id),link={id:'link-'+id,from:root.id,to:n.id,relationType:'note',label:'note',meaning:root.label+' → '+relation+' → '+text,originalLabels:[relation],status:'user',primary:true,sourceRefs:[]};state.graph.nodes.push(n);state.graph.links.push(link);tree().nodeIds.push(n.id);tree().linkIds.push(link.id);tree().positions[n.id]=p;localDraftRevision++;newIds=new Set([n.id]);persist();query='';$('search').value='';locate(n.id)}notice(ui(mode==='tree'?'treeCreated':'nodeAdded'))}}
$('tree').onchange=e=>changeTree(e.target.value);$('all').onclick=()=>{all=!all;render()};$('search').oninput=e=>{query=e.target.value;render();searchResults()};$('search').onfocus=searchResults;$('search').onkeydown=e=>{if(e.key==='Enter'){const found=matches()[0];if(found){e.preventDefault();locate(found.id)}}};document.addEventListener('click',e=>{if(!e.target.closest('.search-wrap'))$('search-results').classList.add('hidden')});document.addEventListener('keydown',e=>{if(e.key==='Escape'){$('search-results').classList.add('hidden');close()}});
$('map').addEventListener('pointerdown',e=>{if(e.target.closest('button,[data-edge]')||e.button!==0)return;pan={x:e.clientX,y:e.clientY,left:$('map').scrollLeft,top:$('map').scrollTop,moved:false};$('map').classList.add('dragging')});window.addEventListener('pointermove',e=>{if(!pan)return;const dx=e.clientX-pan.x,dy=e.clientY-pan.y;if(Math.abs(dx)+Math.abs(dy)>5)pan.moved=true;$('map').scrollLeft=pan.left-dx;$('map').scrollTop=pan.top-dy});window.addEventListener('pointerup',()=>{if(!pan)return;const moved=pan.moved;pan=null;$('map').classList.remove('dragging');if(!moved&&selected)close()});$('map').addEventListener('wheel',e=>{if(!e.ctrlKey)return;e.preventDefault();manualZoom=true;const old=zoom,r=$('map').getBoundingClientRect(),px=e.clientX-r.left,py=e.clientY-r.top;zoom=Math.max(.5,Math.min(1.8,zoom*(e.deltaY<0?1.09:.92)));const ratio=zoom/old,x=($('map').scrollLeft+px)*ratio-px,y=($('map').scrollTop+py)*ratio-py;resize();$('map').scrollLeft=x;$('map').scrollTop=y},{passive:false});
window.getPaperMapState=()=>clone(state);window.updatePaperMap=function(next){validate(next);if(next.artifact&&BOOT.artifact&&next.artifact.templateSha256!==BOOT.artifact.templateSha256){notice(ui('templateMismatch'));return false;}if(next.paper.id!==state.paper.id||next.revision<=canonicalRevision)return false;if(localDraftRevision){persist();notice(ui('draftSaved'));}const old=new Map(state.graph.nodes.map(n=>[n.id,JSON.stringify(n)]));newIds=new Set(next.graph.nodes.filter(n=>!old.has(n.id)).map(n=>n.id));changedIds=new Set(next.graph.nodes.filter(n=>old.has(n.id)&&JSON.stringify(n)!==old.get(n.id)).map(n=>n.id));if(selected){const redirects=selected.kind==='node'?next.graph.redirects:next.graph.linkRedirects;const seen=new Set();while(redirects?.[selected.id]&&!seen.has(selected.id)){seen.add(selected.id);selected.id=redirects[selected.id];}}state=clone(next);canonicalRevision=next.revision;localDraftRevision=0;if(!state.graph.trees.some(t=>t.id===activeTree))activeTree='main';render();setTimeout(()=>{newIds.clear();document.querySelectorAll('.new-node').forEach(el=>el.classList.remove('new-node'))},1900);return true};
async function refresh(){if(!/^https?:$/.test(location.protocol)||sourceUnavailable)return;try{const response=await fetch('paper-state.json',{cache:'no-store'});if(!response.ok){sourceUnavailable=true;return}const next=await response.json();if(next.revision>state.revision)window.updatePaperMap(next)}catch(error){sourceUnavailable=true}}
validate(state);render();requestAnimationFrame(fit);new ResizeObserver(()=>{if(!manualZoom)fit()}).observe($('map'));refresh();setInterval(refresh,2000);
</script></body></html>